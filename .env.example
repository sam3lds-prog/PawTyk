# Copy to .env.local (git-ignored) and fill in what you have. Empty = that service stays off.
# See docs/native-setup.md.

# Public contact address (privacy policy, support page). Required for an App Store build (npm run release:check).
VITE_CONTACT_EMAIL=
# Where the hosted privacy policy lives (npm run site:deploy). Settings links to it; the same URL goes in App Store Connect.
VITE_PRIVACY_URL=

# RevenueCat public iOS SDK key (starts with appl_). Enables gem packs on the iOS app.
VITE_REVENUECAT_IOS_KEY=

# AdMob: set ENABLED=1 only after Info.plist has GADApplicationIdentifier, SKAdNetworkItems and
# NSUserTrackingUsageDescription. Leave REWARDED_IOS empty to use Google's test videos.
VITE_ADMOB_ENABLED=
VITE_ADMOB_REWARDED_IOS=

# Firebase Web app config (leaderboards).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=us-central1
# Point a development build at local Firebase emulators.
VITE_FIREBASE_EMULATORS=

# Usage statistics: Google Analytics for Firebase (D47, docs/analytics.md). 1 = the build may send them, but only
# after the player turns on "Share anonymous usage stats". The iOS app also needs GoogleService-Info.plist.
VITE_FIREBASE_ANALYTICS=
# Web only (dev and tester pages): the Firebase web app's measurement id (G-…).
VITE_FIREBASE_MEASUREMENT_ID=
